@if (TempData["Exito"] is string exito)
{
    <div class="alerta alerta-exito" role="status">@Html.Icono("check")<span>@exito</span></div>
}
@if (TempData["Error"] is string error)
{
    <div class="alerta alerta-error" role="alert">@Html.Icono("error")<span>@error</span></div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alerta alerta-aviso" role="status">@Html.Icono("alerta")<span>@aviso</span></div>
}
